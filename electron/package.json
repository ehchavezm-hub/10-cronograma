{
  "name": "ecm-cronograma",
  "productName": "ECM Cronograma",
  "version": "1.0.1",
  "description": "Gestión de cronogramas y proyectos ECM",
  "main": "main.js",
  "author": "E. Chávez",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.ecm.cronograma",
    "productName": "ECM Cronograma",
    "copyright": "© 2026 E. Chávez",
    "asar": true,
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "index.html",
          "manifest.json",
          "sw.js",
          "icon.png",
          "css/**/*",
          "js/**/*",
          "!js/**/*.test.*",
          "!js/test*",
          "!electron/**",
          "!dist-win/**",
          "!node_modules/**",
          "!.git/**",
          "!sql/**",
          "!tests/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "../icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "../icon.ico",
      "uninstallerIcon": "../icon.ico",
      "shortcutName": "ECM Cronograma"
    },
    "directories": {
      "output": "../dist-win",
      "buildResources": ".."
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehchavezm-hub/10-cronograma"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  }
}
